# Public production URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Server-only. Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# PayU Payment Gateway Credentials. Server-only.
# The PAYU_MERCHANT_* aliases are also accepted for existing deployments.
PAYU_KEY=YOUR_PAYU_KEY
PAYU_SALT=YOUR_PAYU_SALT
# Use "production" only with live PayU credentials; otherwise use "test".
PAYU_ENVIRONMENT=test

# Shiprocket Checkout for custom websites. These values are server-only: the
# app signs checkout and webhook payloads without exposing either credential.
SHIPROCKET_API_KEY=YOUR_SHIPROCKET_CHECKOUT_API_KEY
SHIPROCKET_SECRET_KEY=YOUR_SHIPROCKET_CHECKOUT_SECRET_KEY

# Razorpay (optional / legacy). Only the key ID is safe to expose to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Shiprocket API user credentials. These values are server-only. The pickup
# location must exactly match an already configured Shiprocket pickup location.
# Use the real, packed parcel dimensions and weight—not product-only estimates.
SHIPROCKET_API_EMAIL=api-user@example.com
SHIPROCKET_API_PASSWORD=GENERATE_A_LONG_UNIQUE_API_USER_PASSWORD
SHIPROCKET_PICKUP_LOCATION=Primary Warehouse
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=25
SHIPROCKET_DEFAULT_BREADTH_CM=20
SHIPROCKET_DEFAULT_HEIGHT_CM=5

# Server-only shared token that authenticates Shiprocket's status webhook.
# Register the same value in Shiprocket (Settings > API > Webhooks) as the
# request token; it arrives in the `x-api-key` header. Use a unique value with
# at least 16 characters: `openssl rand -hex 24`.
SHIPROCKET_WEBHOOK_TOKEN=GENERATE_A_LONG_UNIQUE_WEBHOOK_TOKEN

# Signs short-lived order success and cancellation links. Use a unique value
# with at least 32 characters: `openssl rand -hex 32`.
ORDER_ACCESS_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

# Server-only. Used by Vercel Cron when calling /api/cron/store-maintenance.
CRON_SECRET=GENERATE_A_DIFFERENT_VALUE_WITH_OPENSSL_RAND_HEX_32

# Managed Redis for consistent rate limiting across production instances.
# Both values must be configured together. Local development can use the
# bounded in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Country code + number, digits only. WhatsApp is support-only.
NEXT_PUBLIC_DEVELOPER_SUPPORT_WHATSAPP=
NEXT_PUBLIC_DESIGNER_SUPPORT_WHATSAPP=

# Public support email shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.example

# Admin Email Notifications (via Gmail SMTP)
# EMAIL_USER should be the Gmail address you want to send from (e.g. darajni.in@gmail.com)
# EMAIL_APP_PASSWORD must be a 16-character Google App Password, NOT your regular password.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Backups & disaster recovery (optional until configured).
# All values below are server-only. Never expose any of them through a
# NEXT_PUBLIC_ variable. Encrypted PostgreSQL dumps are uploaded to a private
# Supabase Storage bucket ("backups", created automatically on first run), so
# they survive even if the database is lost. Retention is capped at 30 days.
# See docs/BACKUP_DISASTER_RECOVERY.md for the full setup and restore guide.
# ---------------------------------------------------------------------------

# Direct PostgreSQL connection string for pg_dump. Use the DIRECT connection
# (port 5432, sslmode=require), NOT the Supabase pooler (port 6543) and NOT the
# anon key. Find it in Supabase Dashboard > Project Settings > Database >
# Connection string > URI (choose the "Direct" one). Server-only.
SUPABASE_DB_URL=

# 32-byte AES-256 key, base64. Generate with: openssl rand -base64 32
# NEVER lose this key: backups are useless without it, and it is not stored
# anywhere inside Supabase. Server-only.
BACKUP_ENCRYPTION_KEY=

# Private Supabase Storage bucket for backups. Created automatically on first
# run when missing; defaults to "backups". Server-only.
BACKUP_BUCKET=backups

# OPTIONAL dedicated backup destination — a DIFFERENT Supabase project (e.g.
# created under another account) so backups survive even if the production
# project is lost. Copy both values from that backup project's Dashboard >
# Project Settings > API (URL + service_role key). Set BOTH together; when
# omitted, backups are stored in this app's own Supabase project. Server-only.
BACKUP_DEST_SUPABASE_URL=
BACKUP_DEST_SERVICE_ROLE_KEY=

# Days to keep backups (1-30, values above 30 are clamped to 30). Always keeps
# the newest successful backup and at least seven successful backups regardless
# of age as a safety net. Default 30. Server-only.
BACKUP_RETENTION_DAYS=30

# Documented schedule (UTC). The real schedule lives in vercel.json and the
# GitHub Actions workflow. Default is daily at 02:00 UTC: "0 2 * * *".
BACKUP_SCHEDULE=0 2 * * *

# Path segment that scopes backup objects, e.g. "production" or "staging".
# Default "production". Server-only.
BACKUP_ENV=production

# Optional comma-separated list of schemas to dump (e.g. "public,storage"). If
# empty, all schemas the role can access are dumped. Server-only.
BACKUP_DB_SCHEMAS=

# Hard timeout for pg_dump in milliseconds. Default 600000 (10 minutes).
BACKUP_DUMP_TIMEOUT_MS=600000

# Enables the optional Supabase Storage file backup (needs the existing
# SUPABASE_SERVICE_ROLE_KEY). Off by default. Server-only.
BACKUP_STORAGE_ENABLED=false

# GitHub token (fine-grained, Actions: Read & Write on this repo only) used by
# the admin panel to dispatch the guarded "Restore Database Backup" workflow.
# Create at github.com/settings/tokens. Vercel-only; never in browser code.
BACKUP_RESTORE_GH_TOKEN=
# Optional override if the repository ever moves. Defaults to 7amankrishna/darajni.
BACKUP_GITHUB_REPO=
