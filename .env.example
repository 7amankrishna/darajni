# Public production URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Server-only. Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Razorpay. Only the key ID is safe to expose to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Signs short-lived order success and cancellation links.
ORDER_ACCESS_SECRET=generate-a-long-random-secret

# Server-only. Used by Vercel Cron when calling /api/cron/store-maintenance.
CRON_SECRET=generate-another-long-random-secret

# Optional managed Redis used for checkout and tracking rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Country code + number, digits only. WhatsApp is support-only.
NEXT_PUBLIC_DEVELOPER_SUPPORT_WHATSAPP=
NEXT_PUBLIC_DESIGNER_SUPPORT_WHATSAPP=

# Public support email shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.example
