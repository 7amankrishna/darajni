# Public production URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Server-only. Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Razorpay. Only the key ID is safe to expose to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Shiprocket API user credentials. These values are server-only. The pickup
# location must exactly match an already configured Shiprocket pickup location.
# Use the real, packed parcel dimensions and weight—not product-only estimates.
SHIPROCKET_API_EMAIL=api-user@example.com
SHIPROCKET_API_PASSWORD=GENERATE_A_LONG_UNIQUE_API_USER_PASSWORD
SHIPROCKET_PICKUP_LOCATION=Primary Warehouse
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=25
SHIPROCKET_DEFAULT_BREADTH_CM=20
SHIPROCKET_DEFAULT_HEIGHT_CM=5

# Signs short-lived order success and cancellation links. Use a unique value
# with at least 32 characters: `openssl rand -hex 32`.
ORDER_ACCESS_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

# Server-only. Used by Vercel Cron when calling /api/cron/store-maintenance.
CRON_SECRET=GENERATE_A_DIFFERENT_VALUE_WITH_OPENSSL_RAND_HEX_32

# Managed Redis for consistent rate limiting across production instances.
# Both values must be configured together. Local development can use the
# bounded in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Country code + number, digits only. WhatsApp is support-only.
NEXT_PUBLIC_DEVELOPER_SUPPORT_WHATSAPP=
NEXT_PUBLIC_DESIGNER_SUPPORT_WHATSAPP=

# Public support email shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.example
